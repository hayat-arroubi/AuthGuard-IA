# .env.example — Copiez en .env et remplissez les valeurs

# ── Sécurité ────────────────────────────────────────────────────
SECRET_KEY=changez-cette-valeur-en-production-xyz123
JWT_SECRET_KEY=changez-cette-valeur-jwt-en-production-abc456

# ── Base de données ─────────────────────────────────────────────
# Développement : laissez vide (SQLite auto)
# Production OCI Sprint 6 :
# DATABASE_URL=oracle+cx_Oracle://user:password@host:1521/service

# ── Mail (Gmail exemple) ────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre.email@gmail.com
MAIL_PASSWORD=votre-app-password-gmail
MAIL_DEFAULT_SENDER=noreply@authplatform.com
ADMIN_EMAIL=admin@authplatform.com

# ── Application ─────────────────────────────────────────────────
FLASK_ENV=development
APP_URL=http://localhost:5000

# ── OCI (Sprint 6) ──────────────────────────────────────────────
# OCI_DB_URL=oracle+cx_Oracle://...
